<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX Toolset v3 source: produces a Codify .msi. No logos, just the name. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Codify"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="lordpipon"
           UpgradeCode="7D4E1A2B-3C5D-4E6F-8A9B-0C1D2E3F4051">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <Icon Id="appicon" SourceFile="packaging/windows/codify.ico" />
    <Property Id="ARPPRODUCTICON" Value="appicon" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Codify is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Codify">
          <Component Id="MainBinary" Guid="1A2B3C4D-5E6F-4A1B-8C2D-3E4F50617283">
            <File Id="codify.exe" Source="$(var.Source)" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Codify">
          <Component Id="StartMenuEntry" Guid="2B3C4D5E-6F70-4B2C-9D3E-4F5061728394">
            <Shortcut Id="CodifyShortcut"
                      Name="Codify"
                      Description="Codify - a fast, minimal IDE"
                      Target="[INSTALLFOLDER]codify.exe"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="appicon" />
            <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Codify" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <Feature Id="MainFeature" Title="Codify" Level="1">
      <ComponentRef Id="MainBinary" />
      <ComponentRef Id="StartMenuEntry" />
    </Feature>
  </Product>
</Wix>
